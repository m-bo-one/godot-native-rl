[gd_scene load_steps=8 format=3]

; Solid-hurdle jumping world (#286): the hurdles physically collide (HurdleTrack.solid=true), the
; agent gets jump-launch shaping (jump_weight>0) + a raised clear bonus + a more forgiving fall_height
; (crouched landings after a leap aren't a fall), and the curriculum ramps SOLID hurdle height
; low->tall. Same 35-dim obs as the perception-only hurdles agent, so it warm-starts from
; models/quadruped_hurdles.zip.

[ext_resource type="Script" path="res://examples/quadruped_walk/quadruped_game.gd" id="1"]
[ext_resource type="Script" path="res://examples/quadruped_walk/quadruped_hurdles_agent.gd" id="2"]
[ext_resource type="Script" path="res://examples/quadruped_walk/hurdle_track.gd" id="3"]
[ext_resource type="Script" path="res://addons/godot_native_rl/sensors/raycast_sensor_3d.gd" id="4"]
[ext_resource type="Script" path="res://addons/godot_native_rl/training/curriculum_controller.gd" id="5"]

