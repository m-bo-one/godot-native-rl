[gd_scene load_steps=15 format=3]

; Deploy demo for the SOLID-hurdle jumping gait (#286): the trained net runs the solid-hurdle course
; and must LEAP the physically-solid walls (it can't pass through). Hurdles match the training "tall"
; stage (4 solid hurdles, 0.30 m, spacing 8). Side-follow camera frames the leap profile.

[ext_resource type="Script" path="res://examples/quadruped_walk/quadruped_game.gd" id="1"]
[ext_resource type="Script" path="res://examples/quadruped_walk/quadruped_hurdles_agent.gd" id="2"]
[ext_resource type="Script" path="res://examples/quadruped_walk/hurdle_track.gd" id="3"]
[ext_resource type="Script" path="res://addons/godot_native_rl/sensors/raycast_sensor_3d.gd" id="4"]
[ext_resource type="Script" path="res://addons/godot_native_rl/sync.gd" id="5"]
[ext_resource type="Script" path="res://examples/quadruped_walk/quadruped_hud.gd" id="6"]
[ext_resource type="Script" path="res://addons/godot_native_rl/camera/orbit_camera.gd" id="8"]
[ext_resource type="Script" path="res://addons/godot_native_rl/debug/demo_legend.gd" id="legend"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat"]
sky_top_color = Color(0.28, 0.42, 0.6, 1)
sky_horizon_color = Color(0.55, 0.6, 0.62, 1)
ground_bottom_color = Color(0.12, 0.14, 0.13, 1)
ground_horizon_color = Color(0.4, 0.44, 0.44, 1)

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 3
ambient_light_energy = 0.75
tonemap_mode = 2

[sub_resource type="BoxShape3D" id="GroundShape"]
size = Vector3(80, 1, 80)

[sub_resource type="BoxMesh" id="GroundMesh"]
size = Vector3(80, 1, 80)

[sub_resource type="StandardMaterial3D" id="GroundMat"]
albedo_color = Color(0.22, 0.42, 0.27, 1)

[node name="Game" type="Node3D"]
script = ExtResource("1")
finish_path = NodePath("Finish")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

[node name="Ground" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)

[node name="GroundCol" type="CollisionShape3D" parent="Ground"]
shape = SubResource("GroundShape")

[node name="GroundMesh" type="MeshInstance3D" parent="Ground"]
mesh = SubResource("GroundMesh")
material_override = SubResource("GroundMat")

[node name="Finish" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 40)

[node name="Hurdles" type="Node3D" parent="."]
script = ExtResource("3")
solid = true
hurdle_count = 4
hurdle_height = 0.3
hurdle_spacing = 8.0

[node name="RaySensor" type="Node3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0.5, 0)
script = ExtResource("4")
n_rays_width = 3
n_rays_height = 2
ray_length = 6.0
horizontal_fov = 40.0
vertical_fov = 25.0
collision_mask = 2

[node name="Agent" type="Node3D" parent="."]
script = ExtResource("2")
game_path = NodePath("..")
hurdle_track_path = NodePath("../Hurdles")
ray_sensor_path = NodePath("../RaySensor")
control_mode = 3
model_param_path = "res://examples/quadruped_walk/models/quadruped_jump.ncnn.param"
model_bin_path = "res://examples/quadruped_walk/models/quadruped_jump.ncnn.bin"

[node name="Sync" type="Node" parent="."]
script = ExtResource("5")
control_mode = 2
action_repeat = 4

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
rotation_degrees = Vector3(-55, -35, 0)
shadow_enabled = true

[node name="Camera3D" type="Camera3D" parent="."]
current = true
script = ExtResource("8")
default_offset = Vector3(6.5, 2.0, -1.5)
smooth = 5.0

[node name="HUD" type="CanvasLayer" parent="."]

[node name="DistanceLabel" type="Label" parent="HUD"]
offset_left = 16.0
offset_top = 16.0
script = ExtResource("6")
game_path = NodePath("../..")

[node name="DemoLegend" type="CanvasLayer" parent="."]
script = ExtResource("legend")
lines = PackedStringArray("ORANGE/TEAL quadruped = RL agent", "RED walls = SOLID hurdles it must leap   YELLOW line = finish")
