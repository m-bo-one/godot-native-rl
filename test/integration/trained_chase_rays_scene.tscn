[gd_scene load_steps=6 format=3]

; Sim-to-deploy regression for the chase_rays NumPy twin (#364): the policy was trained entirely
; in Python with ANALYTIC ray-vs-AABB observations (scripts/chase_rays_twin_env.py — no Godot, no
; socket) and must still catch targets in the REAL engine, where the same 8 rays come from actual
; physics casts against StaticBody2D boxes and the agent is blocked by the solid obstacle field.
; Reuses the standard trained-chase behavioral checker. Gate note: ncnn fp/threading makes
; near-tie argmaxes machine-dependent, so catch counts vary per machine/run (measured 9-17 across
; Godot 4.5/4.6 on one box for this net; CI machines land lower). min_catches 4 stays far above a
; random policy (~0-1 with obstacles) while leaving CI headroom — same looseness rationale as the
; Jolt behavioral checks.

[ext_resource type="Script" path="res://examples/chase_the_target/chase_rays_game.gd" id="1"]
[ext_resource type="Script" path="res://examples/chase_the_target/chase_rays_agent.gd" id="2"]
[ext_resource type="Script" path="res://addons/godot_native_rl/sync.gd" id="3"]
[ext_resource type="Script" path="res://test/integration/trained_chase_checker.gd" id="4"]
[ext_resource type="Script" path="res://addons/godot_native_rl/sensors/raycast_sensor_2d.gd" id="5"]

[node name="ChaseGame" type="Node2D"]
script = ExtResource("1")
agent_body_path = NodePath("AgentBody")
target_path = NodePath("Target")

[node name="AgentBody" type="Node2D" parent="."]

[node name="RaySensor" type="Node2D" parent="AgentBody"]
script = ExtResource("5")
n_rays = 8
cone_degrees = 315.0
ray_length = 300.0
collision_mask = 1

[node name="Target" type="Node2D" parent="."]

[node name="ChaseAgent" type="Node2D" parent="."]
script = ExtResource("2")
game_path = NodePath("..")
ray_sensor_path = NodePath("../AgentBody/RaySensor")
control_mode = 3
model_param_path = "res://examples/chase_the_target/models/chase_rays_twin.ncnn.param"
model_bin_path = "res://examples/chase_the_target/models/chase_rays_twin.ncnn.bin"

[node name="Sync" type="Node" parent="."]
script = ExtResource("3")
control_mode = 2

[node name="TrainedChecker" type="Node" parent="."]
script = ExtResource("4")
game_path = NodePath("..")
agent_path = NodePath("../ChaseAgent")
frames_to_run = 1800
min_catches = 4
