[gd_scene load_steps=7 format=3]

; Sim-to-deploy regression for the chase_rays NumPy twin (#364): the policy was trained entirely
; in Python with ANALYTIC ray-vs-AABB observations (scripts/chase_rays_twin_env.py — no Godot, no
; socket) and must still catch targets in the REAL engine, where the same 8 rays come from actual
; physics casts against StaticBody2D boxes and the agent is blocked by the solid obstacle field.
; Reuses the standard trained-chase behavioral checker (catches gate).

[ext_resource type="Script" path="res://examples/chase_the_target/chase_rays_game.gd" id="1"]
