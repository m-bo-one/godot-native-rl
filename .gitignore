# Godot editor/cache
.godot/

# Godot 4.4+ regenerates a *.uid sidecar per script on every editor/import pass (e.g.
# run_tests.sh's class-cache regen) — ~200 untracked files that are easy to sweep into a commit
# by accident (#181). Ignore them all; git keeps the 3 intentionally-tracked ones tracked
# regardless (NcnnAgent.gd.uid, addons/.../ncnn_runner.gdextension.uid, node_2d.gd.uid).
*.uid

# Local build artifacts
addons/godot_native_rl/bin/
*.os
*.o
.sconsign.dblite

# Local dependencies (built/managed outside this repo)
godot-cpp/
thirdparty/

# Python env/cache
.venv/
__pycache__/
models/__pycache__/
models/*.pt
models/*.pt.shape.json
models/*.onnx
models/*.onnx.data
models/*.pnnx.*
models/*_ncnn.py
models/*_pnnx.py

# Part 2B training
.venv-train/
logs/
models/chase_policy.*
models/chase_partial.*
models/chase_partial_ckpts/
models/rover_checkpoints/
models/chase_memory_checkpoints/
# Self-play league artifacts (#29): pools of frozen snapshots + ELO ledgers + phase temps
models/selfplay_pool/
models/selfplay_tmp/
models/quadruped_walk.zip
models/quadruped_jump.zip
models/quadruped_jump.pt
models/quadruped_jump.pt.shape.json
models/quadruped_jump_v2.zip
models/quadruped_jump_v2.pt
models/quadruped_jump_v2.pt.shape.json
models/quadruped_jump_v2_ckpts/
# Jump training intermediates for any version (v3, v4, …) — deploy nets live in examples/
models/quadruped_jump_v*.zip
models/quadruped_jump_v*.pt
models/quadruped_jump_v*.pt.shape.json
models/quadruped_jump_v*_ckpts/
models/quadruped_walk_action_dist.json
models/quadruped_walk_ckpts/
# Intermediate SB3 training-checkpoint dirs (deploy nets live in examples/.../models/ instead)
models/quadruped_hurdles_ckpts/
models/quadruped_walk_base_ckpts/
models/quadruped_jump_ckpts/
# Trained SB3/ONNX artifacts (the deployable ncnn model goes to examples/rover_3d/models/ instead)
models/rover_policy.*

# INT8 quantize tools (built locally, like bin/)
thirdparty/ncnn/build-tools/
thirdparty/ncnn/tools-bin/
.DS_Store

# README/doc media are not game resources; ignore Godot's generated import sidecars for them.
media/*.import

# Claude Code runtime state (machine-local; settings.json IS tracked, the lock is not)
.claude/scheduled_tasks.lock

# Editor export output
/build/

# Installed by the plugin from addons/godot_native_rl/script_templates/ (editor-enable side effect)
/script_templates/
# Hide & seek multipolicy training artifacts (deploy nets in examples/hide_and_seek/models/)
models/hide_seek_seeker.pt
models/hide_seek_hider.pt
models/hide_seek_*.pt.shape.json
# NumPy-twin training artifacts (#37/#364; deploy nets live in examples/chase_the_target/models/)
models/chase_twin.zip
models/chase_rays_twin.zip
models/chase_rays_twin.ncnn.*
models/chase_jax_twin.ncnn.*
# Coop MA-POCA training artifacts (deploy net lives in examples/coop_collect/models/)
models/coop_mapoca.zip
models/coop_mapoca.pt
models/coop_mapoca.pt.shape.json

# Large regenerable BC demos (#260) — regenerate via examples/sorter/record_sorter_demos.tscn
examples/sorter/demos/*.json
/user_recipes/
models/chase_reward_designed.json
